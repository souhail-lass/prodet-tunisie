# Prodet Platform — local environment
# Copy to `.env.local` and fill in values for local development.
# DO NOT COMMIT `.env.local`.

# ---------------------------------------------------------------------------
# Public (exposed to the browser — must NEVER contain secrets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E.164 formatted, used for the WhatsApp deep link in the public site shell.
# Leave blank to hide the WhatsApp button.
NEXT_PUBLIC_DEFAULT_WHATSAPP_E164=

# ---------------------------------------------------------------------------
# Database (Postgres / Supabase)
# Use a *direct* connection string for drizzle-kit (port 5432), not the
# pooled / transaction-pooler URL (port 6543).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prodet

# ---------------------------------------------------------------------------
# Supabase (server-only — used by server components / actions / cron jobs)
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Email (transactional outbound + inbound parsing)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@prodet.tn
# POSTMARK_INBOUND_TOKEN=

# ---------------------------------------------------------------------------
# AI providers (extraction + embeddings)
# Pick one provider per role; both can be set during evaluation.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Background jobs (Inngest)
# ---------------------------------------------------------------------------
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Observability (server-only)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# LOGTAIL_SOURCE_TOKEN=

# ---------------------------------------------------------------------------
# Swiver (filled in once spike-swiver-api decides the integration shape)
# ---------------------------------------------------------------------------
# SWIVER_API_BASE_URL=
# SWIVER_API_TOKEN=
