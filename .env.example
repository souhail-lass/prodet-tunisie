# Prodet Platform — local environment
# Copy to `.env.local` and fill in values for local development.
# DO NOT COMMIT `.env.local`.

# ---------------------------------------------------------------------------
# Public (exposed to the browser — must NEVER contain secrets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# E.164 formatted, used for the WhatsApp deep link in the public site shell.
# Leave blank to hide the WhatsApp button.
NEXT_PUBLIC_DEFAULT_WHATSAPP_E164=

# ---------------------------------------------------------------------------
# Database (Postgres / Supabase)
# Use a *direct* connection string for drizzle-kit (port 5432), not the
# pooled / transaction-pooler URL (port 6543).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prodet

# ---------------------------------------------------------------------------
# Supabase (server-only — used by server components / actions / cron jobs)
# ---------------------------------------------------------------------------
# Required for admin magic-link auth and protected admin routes.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required later for server-side admin operations that need Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name for customer-uploaded documents (BC, invoices, ERP
# exports, …). Must exist in Supabase Storage with public access disabled.
SUPABASE_CUSTOMER_DOCUMENTS_BUCKET=customer-documents

# ---------------------------------------------------------------------------
# Email (transactional outbound + inbound parsing)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@prodet.tn
# QUOTE_NOTIFICATION_EMAIL=prodet.tunisie@gmail.com
# POSTMARK_INBOUND_TOKEN=

# ---------------------------------------------------------------------------
# AI providers (extraction + embeddings)
# Pick one provider per role; both can be set during evaluation.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Background jobs (Inngest)
# ---------------------------------------------------------------------------
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Observability (server-only)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# LOGTAIL_SOURCE_TOKEN=

# ---------------------------------------------------------------------------
# Swiver — see ADR 0012 and src/integrations/swiver/README.md
# `disabled` (default) keeps every Swiver-backed surface in no-op mode.
# Switch to `sandbox` only when the live HTTP adapter has been pointed at a
# real tenant. The webhook route is mounted at /api/webhooks/swiver
# regardless of mode (so you can wire it in Swiver's integration panel).
# ---------------------------------------------------------------------------
# SWIVER_MODE=disabled
# Live Open API host (confirmed). NOT sandbox.swiver.io (that's the web app).
# SWIVER_API_BASE_URL=https://server.swiver.io
# Integration token from Swiver → Intégration → Application web. Sent as the
# `X-AUTH-TOKEN` request header by the adapter.
# SWIVER_API_KEY=
# Shared secret for /api/webhooks/swiver HMAC verification. REQUIRED in
# production once SWIVER_MODE != disabled — without it the webhook refuses
# inbound traffic in production. Use a long random value (e.g. `openssl rand -hex 32`).
# SWIVER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Client-portal DEMO preview (LOCAL DEV ONLY)
# ---------------------------------------------------------------------------
# When set to 1 (and NODE_ENV != production), the client portal renders mock
# data without a real Supabase session so you can preview the UI. This BYPASSES
# client authentication — NEVER set it in a deployed/production environment.
PORTAL_DEMO_MODE=0
