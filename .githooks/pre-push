#!/usr/bin/env bash
# Block pushes that would fail GitHub CI format/lint/typecheck/tests.
# Enable with: git config core.hooksPath .githooks  (also set by pnpm prepare)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running CI gate (format + lint + typecheck + db:check + tests)…"
pnpm format:check
pnpm lint
pnpm typecheck
pnpm db:check
pnpm test
echo "pre-push: OK"
